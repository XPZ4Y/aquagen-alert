+    fn ts_defaults_to_a_real_datetime() {
+        let r = PondReading { ts: chrono::Utc.with_ymd_and_hms(2026, 10, 6, 6, 0, 0).unwrap(), ..Default::default() };
+        assert_eq!(r.ts.format("%d-%b %H:%M").to_string(), "06-Oct 06:00");
+    }
+}

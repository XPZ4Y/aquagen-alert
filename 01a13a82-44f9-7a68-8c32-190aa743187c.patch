+[package]
+name = "aqua-alert"
+version = "0.1.0"
+edition = "2021"
+rust-version = "1.75"
+description = "Sensorless-first early disease & water-quality alerts for small aquaculture farms — a 1:1 Rust rewrite of the AquaAlert Python/uv backend. Compiles to a single self-contained binary."
+readme = "README.md"
+license = "MIT"
+authors = ["AquaAlert team"]
+keywords = ["aquaculture", "water-quality", "alerts", "fastapi-port", "onnx"]
+categories = ["command-line-utilities", "web-programming::http-server"]
+
+[[bin]]
+name = "aqua-alert"
+path = "src/main.rs"
+
+[lib]
+name = "aqua_alert"
+path = "src/lib.rs"
+
+[features]
+default = ["server"]
+# The HTTP service (axum). Turn off to build only the library + CLI offline path.
+server = ["dep:axum", "dep:tower-http"]
+# Deep-model photo triage via ONNX Runtime — mirrors the Python `ml` extra
+# (torch/transformers). Off by default so the base build stays a single,
+# dependency-light binary that uses the abstaining colour heuristic.
+onnx = ["dep:ort", "dep:ndarray"]
+
+[dependencies]
+serde = { version = "1", features = ["derive"] }
+serde_json = { version = "1", features = ["preserve_order"] }
+chrono = { version = "0.4", features = ["serde"] }
+anyhow = "1"
+sha1 = "0.10"
+once_cell = "1"
+clap = { version = "4", features = ["derive"] }
+# Pure-Rust image decode (JPEG/PNG) for the offline triage heuristic — no C deps,
+# so the binary stays self-contained.
+image = { version = "0.25", default-features = false, features = ["jpeg", "png"] }
+# HTTPS client for Open-Meteo / USGS WQP. rustls (not OpenSSL) => portable binary.
+reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
+tracing = "0.1"
+tracing-subscriber = { version = "0.3", features = ["env-filter"] }
+
+# Async runtime: needed by the reqwest client (forecast) and by the HTTP service.
+tokio = { version = "1", features = ["macros", "rt-multi-thread", "signal", "time", "sync", "net"] }
+
+# --- HTTP service (feature = "server", on by default) ---
+axum = { version = "0.7", features = ["multipart", "json"], optional = true }
+tower-http = { version = "0.5", features = ["cors", "trace"], optional = true }
+
+# --- deep-model AI (feature = "onnx") ---
+# ONNX Runtime bindings. `download-binaries` statically links ORT so the result
+# is still one binary; flip to `load-dynamic` to dlopen a system libonnxruntime.
+# This feature is OFF by default and was not compiled in-sandbox (no crates.io
+# access here), so the exact rc API may need a small tweak — see export/README.md.
+ort = { version = "2.0.0-rc.10", optional = true, default-features = false, features = ["ndarray", "download-binaries"] }
+# MUST match the ndarray version ort links against, or `input.view()` won't unify
+# with ort's tensor type. ort 2.0.0-rc.10 uses ndarray 0.16; align if you pin a
+# different rc.
+ndarray = { version = "0.16", optional = true }
+
+[profile.release]
+opt-level = 3
+lto = "fat"
+codegen-units = 1
+# NOTE: deliberately not `panic = "abort"` — that setting is incompatible with
+# running the test harness (`cargo test --release`). The binary is still one
+# self-contained file without it; use `strip`/`lto` for size.
+strip = true
